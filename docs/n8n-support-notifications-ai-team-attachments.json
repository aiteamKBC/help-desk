        "parameters": {
          "jsCode": "const input = $input.first();\nconst inputJson = input.json || {};\nconst binary = input.binary || {};\n\nlet payloadCandidate = inputJson.body ?? inputJson;\nlet payload = payloadCandidate;\n\nif (binary.body) {\n  const buffer = await this.helpers.getBinaryDataBuffer(0, 'body');\n  payloadCandidate = buffer.toString('utf8');\n}\n\nif (payloadCandidate && typeof payloadCandidate === 'object' && !Array.isArray(payloadCandidate) && Object.prototype.hasOwnProperty.call(payloadCandidate, 'body')) {\n  payloadCandidate = payloadCandidate.body;\n}\n\nif (typeof payloadCandidate === 'string') {\n  try {\n    payload = JSON.parse(payloadCandidate);\n  } catch (error) {\n    payload = { body: payloadCandidate };\n  }\n} else {\n  payload = payloadCandidate;\n}\n\nif (!payload || typeof payload !== 'object' || Array.isArray(payload)) {\n  payload = { body: payloadCandidate };\n}\n\nfunction escapeHtml(value) {\n  return String(value ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#039;');\n}\n\nfunction formatBytes(value) {\n  const size = Number(value || 0);\n  if (!Number.isFinite(size) || size <= 0) return '';\n  if (size < 1024) return `${size} B`;\n  if (size < 1024 * 1024) return `${Math.round(size / 1024)} KB`;\n  return `${(size / 1024 / 1024).toFixed(1)} MB`;\n}\n\nconst attachmentProperties = Object.keys(binary)\n  .filter((key) => key !== 'body' && /^file_\\d+$/.test(key))\n  .sort((left, right) => Number(left.replace('file_', '')) - Number(right.replace('file_', '')));\n\nconst evidenceFiles = Array.isArray(payload.evidence?.files) ? payload.evidence.files : [];\nconst evidenceHtml = evidenceFiles.length\n  ? `<div style='font-size:15px;line-height:1.7;margin-top:10px;'>`\n    + `<strong>Evidence</strong><br>`\n    + `${evidenceFiles.length} file(s) attached to this email.`\n    + evidenceFiles.map((file) => {\n      const name = escapeHtml(file.name || 'attachment');\n      const sizeLabel = formatBytes(file.size);\n      const label = `${name}${sizeLabel ? ` (${escapeHtml(sizeLabel)})` : ''}`;\n      if (file.downloadUrl) {\n        return `<div style='margin-top:6px;'><a href='${escapeHtml(file.downloadUrl)}' style='color:#4f46e5;text-decoration:underline;font-weight:700;'>Open ${label}</a></div>`;\n      }\n      return `<div style='margin-top:6px;color:#374151;'>${label}</div>`;\n    }).join('')\n    + `<div style='font-size:12px;color:#6b7280;margin-top:6px;'>You can also open the Gmail attachment shown above or below this message.</div>`\n    + `</div>`\n  : '';\n\nreturn [\n  {\n    json: {\n      ...payload,\n      attachmentProperties: attachmentProperties.join(','),\n      hasAttachments: attachmentProperties.length > 0,\n      evidenceHtml,\n    },\n    binary,\n  },\n];\n"
